{
  "name": "bus-booking-system",
  "version": "1.0.0",
  "description": "- Backend: Node.js + Express + MongoDB - Frontend: React (Vite) - Mobile: React Native (Expo)",
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "node backend/services/database/migrate.js migrate",
    "db:rollback": "node backend/services/database/migrate.js rollback",
    "db:status": "node backend/services/database/migrate.js status",
    "db:seed": "node backend/services/database/seed.js",
    "docker:up": "docker compose -f backend/services/docker-compose.yml up --build",
    "docker:down": "docker compose -f backend/services/docker-compose.yml down",
    "production:check": "node scripts/production-check.js",
    "ci:verify": "npm run production:check && npm run qa && npm run typecheck && npm test && npm run build",
    "qa": "npm --workspace @busgo/qa test",
    "qa:security": "npm --workspace @busgo/qa run test:security",
    "qa:concurrency": "npm --workspace @busgo/qa run test:concurrency",
    "qa:staging": "npm --workspace @busgo/qa run test:e2e",
    "test:e2e:web": "playwright test --project=web-desktop-chromium",
    "test:e2e:mobile-web": "playwright test --project=mobile-android-chromium --project=mobile-ios-webkit",
    "test:e2e:browser": "playwright test",
    "test:mobile:native": "node scripts/check-native-mobile.mjs",
    "test:e2e:all": "npm run test:e2e:browser && npm run test:mobile:native",
    "mobile:start": "npm --prefix BusGoMobile run start",
    "mobile:android": "npm --prefix BusGoMobile run android",
    "mobile:ios": "npm --prefix BusGoMobile run ios",
    "mobile:typecheck": "npm --prefix BusGoMobile run typecheck",
    "mobile:test": "npm --prefix BusGoMobile test",
    "validate:system": "node scripts/full-system-validation.mjs --run-qa",
    "validate:static": "node scripts/full-system-validation.mjs",
    "validate:live": "node scripts/live-system-smoke.mjs",
    "validate:release": "npm run production:check && npm run validate:dependencies && npm run validate:system && npm run typecheck && npm run build",
    "staging:up": "powershell -ExecutionPolicy Bypass -File staging/start-staging.ps1",
    "staging:validate": "powershell -ExecutionPolicy Bypass -File staging/validate-staging.ps1",
    "staging:down": "powershell -ExecutionPolicy Bypass -File staging/stop-staging.ps1",
    "mobile:install": "npm --prefix BusGoMobile install",
    "e2e:install": "npm install --no-save @playwright/test@1.55.0 && npx playwright install chromium webkit",
    "validate:dependencies": "node scripts/dependency-consistency.mjs",
    "validate:web-ui": "node scripts/web-ui-validation.mjs",
    "whatsapp:local:install": "npm --prefix backend/services/whatsapp-service install",
    "whatsapp:local": "npm --prefix backend/services/whatsapp-service run start:local-whatsapp"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "private": true,
  "workspaces": [
    "frontend",
    "admin-panel",
    "backend/services/*",
    "packages/*"
  ],
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
