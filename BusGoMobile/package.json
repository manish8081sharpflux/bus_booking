{
  "name": "busgo-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node ./scripts/smoke-test.mjs",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test:ui": "node ./scripts/ui-validation.mjs",
    "validate": "npm run test && npm run test:ui"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.0",
    "expo-constants": "~18.1.0",
    "expo-linking": "~8.1.0",
    "expo-router": "~6.1.0",
    "expo-secure-store": "~15.1.0",
    "expo-status-bar": "~3.1.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.18.0",
    "expo-clipboard": "~8.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.1.0",
    "typescript": "~5.9.2"
  }
}
